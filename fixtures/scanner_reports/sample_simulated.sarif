{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {"driver": {"name": "customer-scanner-simulated"}},
      "results": [
        {"ruleId": "XSS-001", "level": "error", "message": {"text": "Reflected XSS"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "https://example.local/a?q=1"}}}]},
        {"ruleId": "UPLOAD-002", "level": "warning", "message": {"text": "上传 webshell 风险"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "https://example.local/upload"}}}]},
        {"ruleId": "RCE-003", "level": "error", "message": {"text": "Remote command execution"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "https://example.local/exec"}}}]}
      ]
    }
  ]
}
